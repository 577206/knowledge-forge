{
  "name": "knowledge-forge",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first ingestion workbench for Obsidian and Markdown knowledge vaults.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/577206/knowledge-forge.git"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "knowledge-base",
    "rag",
    "local-first",
    "ingestion"
  ],
  "scripts": {
    "dev": "node apps/api/server.js",
    "start": "node apps/api/server.js",
    "mcp": "node apps/mcp/server.js",
    "check": "node --check apps/api/server.js && node --check apps/mcp/server.js && node --check packages/ingestion-core/index.js && node --check packages/ingestion-core/config.js && node --check apps/web/app.js && node --check apps/web/graph.js",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure.ps1",
    "start:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "verify:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 -Smoke -StartServer",
    "test": "npm run check"
  },
  "dependencies": {
    "@opendocsg/pdf2md": "latest",
    "busboy": "latest",
    "gray-matter": "latest",
    "jszip": "^3.10.1",
    "mammoth": "latest",
    "xlsx": "latest"
  }
}
