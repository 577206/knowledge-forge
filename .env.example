# Copy this file to .env.local and edit the path.
# Knowledge Forge works best with Full Setup:
# Local Forge + Final Exam Review + Obsidian + NotebookLM + your AI Agent.

# Obsidian / Markdown vault path. Generated notes are written to inbox/ by default.
# Windows example:
KF_VAULT_PATH=E:\创作工坊\知识库\LLM-Wiki

# macOS/Linux example:
# KF_VAULT_PATH=/Users/you/Documents/ObsidianVault

# Optional: override the local web server port.
# PORT=4177
